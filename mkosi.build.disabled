#!/usr/bin/env python3
"""
mkosi build script for rendering Jinja2 templates
Renders all templates from src/templates/ to mkosi.files/etc/
using configuration from src/d9.yaml
"""

import os
import sys
import yaml
from pathlib import Path
from jinja2 import Environment, FileSystemLoader, StrictUndefined

# Paths
SCRIPT_DIR = Path(__file__).parent
CONFIG_FILE = SCRIPT_DIR / "src" / "d9.yaml"
TEMPLATES_DIR = SCRIPT_DIR / "src" / "templates"
OUTPUT_DIR = SCRIPT_DIR / "mkosi.files"

def load_config():
    """Load configuration from d9.yaml"""
    with open(CONFIG_FILE, 'r') as f:
        return yaml.safe_load(f)

def setup_jinja_env():
    """Setup Jinja2 environment"""
    return Environment(
        loader=FileSystemLoader(TEMPLATES_DIR),
        undefined=StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
        keep_trailing_newline=True
    )

def render_templates(config, env):
    """Render all templates"""

    # Template mappings: (template_file, output_path, context_key)
    templates = [
        # Kitty
        ("kitty.conf.j2", "etc/xdg/kitty/kitty.conf", "kitty"),

        # X11
        ("touchpad.conf.j2", "etc/X11/xorg.conf.d/30-touchpad.conf", "x11"),

        # Display Manager
        ("lightdm.conf.j2", "etc/lightdm/lightdm.conf", "display_manager"),
        ("lightdm-gtk-greeter.conf.j2", "etc/lightdm/lightdm-gtk-greeter.conf", "display_manager"),

        # Xfce
        ("xfce4-panel.xml.j2", "etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml", "xfce"),
        ("xfwm4.xml.j2", "etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml", "xfce"),

        # Zoom
        ("update-zoom.sh.j2", "usr/local/sbin/update-zoom", "zoom"),
        ("update-zoom-sudoers.j2", "etc/sudoers.d/update-zoom", None),
    ]

    for template_name, output_path, context_key in templates:
        template_file = TEMPLATES_DIR / template_name

        # Skip if template doesn't exist
        if not template_file.exists():
            print(f"Warning: Template {template_name} not found, skipping")
            continue

        # Get context for template
        if context_key:
            context = config.get(context_key, {})
        else:
            context = {}

        # Render template
        try:
            template = env.get_template(template_name)
            rendered = template.render(**context)

            # Write output
            output_file = OUTPUT_DIR / output_path
            output_file.parent.mkdir(parents=True, exist_ok=True)

            with open(output_file, 'w') as f:
                f.write(rendered)

            # Make executable if it's a script
            if output_path.startswith('usr/local/') and output_path.endswith('.sh'):
                os.chmod(output_file, 0o755)
            if output_path == 'usr/local/sbin/update-zoom':
                os.chmod(output_file, 0o755)

            print(f"Rendered: {template_name} -> {output_path}")

        except Exception as e:
            print(f"Error rendering {template_name}: {e}", file=sys.stderr)
            sys.exit(1)

def main():
    """Main build function"""
    print("=" * 60)
    print("d9 Template Rendering Build Script")
    print("=" * 60)

    # Check dependencies
    if not CONFIG_FILE.exists():
        print(f"Error: Configuration file not found: {CONFIG_FILE}", file=sys.stderr)
        sys.exit(1)

    if not TEMPLATES_DIR.exists():
        print(f"Warning: Templates directory not found: {TEMPLATES_DIR}")
        print("Creating templates directory...")
        TEMPLATES_DIR.mkdir(parents=True, exist_ok=True)

    # Load config
    print(f"\nLoading configuration from {CONFIG_FILE}...")
    config = load_config()

    # Setup Jinja2
    print("Setting up Jinja2 environment...")
    env = setup_jinja_env()

    # Render templates
    print("\nRendering templates...")
    render_templates(config, env)

    print("\n" + "=" * 60)
    print("Build completed successfully!")
    print("=" * 60)

if __name__ == "__main__":
    main()
