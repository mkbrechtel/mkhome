#!/bin/bash
set -euo pipefail

echo "==> Building d9 Debian packages..."

# Use the working directory prepared by the prepare script
WORK_DIR="/opt/d9"
cd "$WORK_DIR"

# Build the packages
echo "==> Building packages with dpkg-buildpackage..."
dpkg-buildpackage -us -uc -b

# Copy the generated .deb files to $PACKAGEDIR
echo "==> Copying packages to $PACKAGEDIR..."
cp -v ../*.deb "$PACKAGEDIR/"

echo "==> Generated packages:"
ls -lh "$PACKAGEDIR"/*.deb

echo "==> Package build complete!"
