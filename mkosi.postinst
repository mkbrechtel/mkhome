#!/bin/bash
# mkosi post-installation script to configure the system image using Ansible
set -e

# This script is called by mkosi after packages and trees are installed
# It runs Ansible to configure system-wide settings in the image

echo "Pre-generating configuration files for mkosi build..."

cd "$SRCDIR"

# Pre-generate kitty configuration since /etc is read-only during Ansible execution
# Use default values from roles/kitty/defaults/main.yaml
mkdir -p "$BUILDROOT/etc/xdg/kitty"
cat > "$BUILDROOT/etc/xdg/kitty/kitty.conf" << 'EOF'
font_family Hack
font_size 11
open_url_with xdg-open
cursor_blink_interval 0
map ctrl+shift+plus change_font_size all +2.0
enable_audio_bell no
confirm_os_window_close 0
EOF

echo "Running Ansible to configure system image..."

# Run Ansible with mkhome_configure_global flag
# This will run all roles' global.yaml tasks to configure /etc and system files
# We're already root in the build environment, so don't use become
# Skip file-writing tasks since /etc is read-only
ansible-playbook \
    --connection=chroot \
    --inventory="$BUILDROOT," \
    --extra-vars='{"mkhome_configure_global": true, "mkhome_configure_home": false, "mkhome_install": false, "ansible_become": false, "mkosi_build": true}' \
    system.yaml
