#!/usr/bin/env -S bash -xc 'cd "$SRCDIR" && export ANSIBLE_CHROOT_DISABLE_ROOT_CHECK="true" ANSIBLE_CALLBACK_RESULT_FORMAT=yaml && exec ansible-playbook -c chroot -e disable_root_check=true -i ",$BUILDROOT" "$0"'
---
- hosts: all
  connection: chroot
  vars:
    mkhome_install: false
    mkhome_configure_global: true
    mkhome_configure_home: false
  roles:
    - home
