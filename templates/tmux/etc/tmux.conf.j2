# tmux configuration for d9
set -g default-terminal "screen-256color"

# Status bar colors (generated from HSL hue: {{hue}})
set -g status-style bg={{status_bg}},fg={{status_fg}}

# Active window colors
setw -g window-status-current-style bg={{active_bg}},fg={{active_fg}}

# Pane border colors
set -g pane-border-style fg={{border_color}}
set -g pane-active-border-style fg={{active_border_color}}

# Additional sensible defaults
set -g history-limit 10000
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
